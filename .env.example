# Local development only. Copy this file to .env and replace every placeholder.
# Host environment variables take precedence over this file.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
SERVE_API_DOCS=True
# Apply pending migrations when the WSGI/ASGI process starts.
AUTO_MIGRATE=True

# Database. MySQL is the default and requires DB_NAME/DB_USER/DB_PASSWORD.
# Set DB_ENGINE=sqlite only to use SQLite locally or in tests; there is no
# implicit fallback when MySQL configuration is missing.
DB_ENGINE=mysql
DB_NAME=ai_market_data
DB_USER=root
DB_PASSWORD=replace-with-the-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_ai_market_data

# Celery broker. Falls back to REDIS_URL, then to memory:// only when DEBUG=True.
# Use 127.0.0.1 when Django runs on the host and Redis is in Docker. Use the
# Compose service name (for example "redis") only inside the same Docker network.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Cache. Unset means per-process LocMemCache. Use db 1 so a broker FLUSHDB
# cannot clear cached values.
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# JWT lifetimes.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Auth throttling rates (DRF syntax: "5/min"). Throttling uses the cache above,
# so a shared Redis cache is required for limits to hold across processes.
AUTH_THROTTLE_REGISTER=5/min
AUTH_THROTTLE_LOGIN=10/min
AUTH_THROTTLE_REFRESH=20/min
AUTH_THROTTLE_LOGOUT=20/min

# Storage. Relative paths resolve against the repository root.
DJANGO_MEDIA_ROOT=media
DJANGO_STATIC_ROOT=staticfiles
